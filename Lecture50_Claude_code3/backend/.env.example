# Copy this file to .env and fill in the connection string.
# Azure Portal > Storage account > Security + networking > Access keys > Connection string
BLOB_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net

UPLOAD_CONTAINER=course-files
SAS_EXPIRY_MINUTES=10

# Frontend origins allowed to call the API
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# true = on startup the API adds a CORS rule for CORS_ORIGINS so the browser
# can PUT files. Existing rules are kept. false = set CORS in the portal yourself.
CONFIGURE_STORAGE_CORS=true
